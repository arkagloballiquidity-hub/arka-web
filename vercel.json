{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/send-simulation.js": { "includeFiles": "api/fonts/**,api/logo_arka.png" },
    "api/send-profiler.js":   { "includeFiles": "api/fonts/**,api/logo_arka.png" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!contract-intake).*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Content-Security-Policy",   "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/contract-intake",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy",   "value": "frame-ancestors 'self' https://my.arkaltd.io" }
      ]
    }
  ]
}
